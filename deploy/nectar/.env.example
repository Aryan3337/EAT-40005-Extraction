# Copy to .env on the Nectar instance and fill in. Never commit .env.
#
#   cp .env.example .env && nano .env
#
# Note what is NOT here: no OLLAMA_TUNNEL_SECRET or TRUSTED_LLM_HOST (those
# existed only for the Tailscale tunnel to a laptop, which this deployment
# replaces). OLLAMA_URL is set in docker-compose.yml, not here.

# ---------------------------------------------------------------------------
# Neo4j / AuraDB. REQUIRED -- this deployment reads the graph, not the CSVs.
# Without all three the API raises at startup:
#   "Neo4j configuration is incomplete."
#
# NEO4J_URI takes a bare Aura hostname (<id>.databases.neo4j.io) and
# config.py prepends neo4j+s:// for you. An unencrypted neo4j:// URI to a
# remote host is REFUSED, deliberately: the graph stores sentence_ref,
# verbatim text from the source papers.
#
# The username is NEO4J_USERNAME, not NEO4J_USER -- config.py reads
# NEO4J_USERNAME and a wrong name fails as "configuration is incomplete".
#
# NEO4J_USERNAME is NOT "neo4j" on the P85 instance. Verified against the
# live database 2026-10-27: "neo4j" fails with
#   Neo.ClientError.Security.Unauthorized
# and the working username is the 8-hex-character string that is also the
# instance id in NEO4J_URI. It looks exactly like a copy-paste mistake and
# is not one -- do not "correct" it back to neo4j. Take all three values
# from the Aura console or the credentials file, and change nothing.
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
# ---------------------------------------------------------------------------

# Gates the admin review and upload endpoints. Without it the API starts
# but refuses every /admin/* request. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Set it here AND type the same value into the admin UI's secret prompt.
ADMIN_UPLOAD_SECRET=

# Set this. It does NOT default to English-only -- rag.py:1068 defaults it
# to "local", which routes Bangla and Hindi through local_translation.py ->
# import torch. torch is not in this image, so a non-English question would
# raise ModuleNotFoundError. English questions never reach that path, so
# leaving it unset breaks only the non-English case, and loudly.
#
#   llm     mistral:7b on this instance does the translating. Keeps every
#           request on the box, which the no-third-party-provider constraint
#           requires. Quality caveat recorded in rag.py:1615 -- the model
#           writes Bangla and Hindi with frequent spelling errors.
#   online  MyMemory. Sends answer text, which is derived from the source
#           papers, to a third party. Do not use without checking that
#           against the data-governance declaration.
#   local   torch + a 2.4GB NLLB model. Not available in this image.
TRANSLATION_PROVIDER=llm
# Only needed for TRANSLATION_PROVIDER=online.
# MYMEMORY_EMAIL=

# Leave unset. Backend speech needs torch, which this image does not carry.
# local_tts refuses cleanly when this is off, so unset is the honest state.
# TTS_ENABLED=1

# Optional. Set to 0 to disable the synthesis relevance gate, which
# refuses to answer when the model judges the retrieved evidence
# irrelevant. Leave it on -- it is the main defence against confident
# wrong answers.
# SYNTHESIS_RELEVANCE_GATE=1

# ---------------------------------------------------------------------------
# API_BASE_URL. REQUIRED, and it is a BUILD-TIME value, unlike everything
# else in this file.
#
# docker-compose.yml passes it to Dockerfile.web, which compiles it into
# main.dart.js via --dart-define. The frontend has no runtime configuration
# for its own API origin, so changing this means rebuilding the web image:
#
#   docker compose up -d --build web
#
# Set it to the origin visitors type, NOT to the API container. nginx proxies
# /query, /auth/..., /admin/... and the rest to the api service on the same
# host, so the browser only ever talks to this one origin.
#
# Use the TLS name, not the bare IP: a bare-IP https:// URL fails the
# certificate's name check, and a bare-IP http:// URL is rewritten to https://
# by Chrome before it leaves the browser (see README.md, P1).
#
# If the instance is ever rebuilt it gets a different public IP -- there is no
# floating IP on this allocation -- so this value and the certificate name
# both change together.
#
# An EMPTY value is worse than a missing one: api_config.dart falls back to
# http://127.0.0.1:8000, which in a visitor's browser is their own machine, so
# the site loads and every request fails. Compose refuses to start without it
# and Dockerfile.web checks again, so neither can happen silently.
API_BASE_URL=https://136.186.108.232.sslip.io
