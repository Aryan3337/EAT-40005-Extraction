# Copy to .env on the Nectar instance and fill in. Never commit .env.
#
#   cp .env.example .env && nano .env
#
# Note what is NOT here: no NEO4J_* (CSV retrieval mode, see
# docker-compose.yml), and no OLLAMA_TUNNEL_SECRET or TRUSTED_LLM_HOST
# (those existed only for the Tailscale tunnel to a laptop, which this
# deployment replaces). OLLAMA_URL is set in docker-compose.yml, not here.

# Gates the admin review and upload endpoints. Without it the API starts
# but refuses every /admin/* request. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Set it here AND type the same value into the admin UI's secret prompt.
ADMIN_UPLOAD_SECRET=

# Optional. Defaults to English-only behaviour if unset.
# TRANSLATION_PROVIDER=
# MYMEMORY_EMAIL=

# Optional. Set to 0 to disable the synthesis relevance gate, which
# refuses to answer when the model judges the retrieved evidence
# irrelevant. Leave it on -- it is the main defence against confident
# wrong answers.
# SYNTHESIS_RELEVANCE_GATE=1
