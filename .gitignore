.~lock.*

# Local git worktrees
.worktrees/
uploads/

# Local speech model weights and pronunciation samples
models/tts/
tts-sample*.wav

# Flutter plugin registrants -- regenerated by `flutter pub get` / build on
# every machine, so they churn per-developer (each dev's plugin set and
# path layout differs) and show up as permanent uncommitted noise.
flutter_application/linux/flutter/generated_plugin_registrant.cc
flutter_application/linux/flutter/generated_plugin_registrant.h
flutter_application/linux/flutter/generated_plugins.cmake
flutter_application/macos/Flutter/GeneratedPluginRegistrant.swift
flutter_application/windows/flutter/generated_plugin_registrant.cc
flutter_application/windows/flutter/generated_plugin_registrant.h
flutter_application/windows/flutter/generated_plugins.cmake

# Nectar deploy: build output and secrets
deploy/nectar/web/*
!deploy/nectar/web/.gitkeep
