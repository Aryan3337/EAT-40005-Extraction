# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real credentials.
#
# This file previously contained a real AuraDB instance id, username and
# password rather than placeholders. That instance no longer exists, so the
# values were dead, but an example file is not a place for live credentials.
# Replaced with placeholders 2026-10-04.

# ---------------------------------------------------------------------------
# Neo4j AuraDB
# ---------------------------------------------------------------------------
# Paste the instance hostname from the Aura console. A bare hostname is
# upgraded to neo4j+s:// automatically (see config.py).
#
# config.py REFUSES an unencrypted neo4j:// or bolt:// URI to a remote host:
# the graph stores sentence_ref, which is verbatim text from the source
# papers, so that connection has to be encrypted. Unencrypted is allowed only
# for a local or self-hosted instance (localhost, a private address, or a
# container name).
#
# Own this instance with the shared team account, not a personal one — it has
# to outlive the handover.
NEO4J_URI=xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=paste-the-password-from-the-aura-console

# ---------------------------------------------------------------------------
# Ollama — local model inference
# ---------------------------------------------------------------------------
# Leave these alone unless you know what you are changing.
#
# This project committed to the supervisor that paper content and
# human-generated data (workshop transcripts, focus-group material) go to a
# LOCAL model only and are never sent to a third-party model provider.
# llm_endpoint.py enforces that: a host outside our own network is refused.
#
# Inside Docker, use the compose service name — "localhost" there is the app
# container itself, not the ollama container:
#     OLLAMA_URL=http://ollama:11434/api/generate
OLLAMA_URL=http://localhost:11434/api/generate
# mistral:7b, not deepseek-r1:7b: both benchmark around 40s for a real chat
# answer, but deepseek-r1 is a "thinking" model whose internal reasoning
# length varies the actual wall-clock time unpredictably -- measured
# 2026-10-05, 2 of 3 real calls exceeded even a 90s timeout. mistral:7b has
# no such overhead.
OLLAMA_MODEL=mistral:7b

# The confidence framework uses /api/chat rather than /api/generate, so it
# has its own variable. Inside Docker: http://ollama:11434/api/chat
# CONFIDENCE_OLLAMA_URL=http://localhost:11434/api/chat

# The pruner's optional LLM judge. Inside Docker:
# OLLAMA_JUDGE_URL=http://ollama:11434/api/generate
# LLM_JUDGE_BACKEND=none

# ---------------------------------------------------------------------------
# Escape hatch — do not set this casually
# ---------------------------------------------------------------------------
# Overrides every local-inference check, allowing content to be sent to an
# external model provider. This exists for the funded private-hosting
# discussion, where a model may legitimately run on a paid instance. Setting
# it breaks the commitment described above, so it is a decision for that
# discussion and not a configuration detail.
# ALLOW_EXTERNAL_LLM=1

# ---------------------------------------------------------------------------
# Hosted API
# ---------------------------------------------------------------------------
# Shared secret the admin upload endpoint requires. Generate a long random
# value; without it the endpoint is open to anyone who finds the URL.
# ADMIN_UPLOAD_SECRET=generate-a-long-random-value
